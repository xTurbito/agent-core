# Proveedor y modelo del LLM
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash

# Tipo de memoria (memory = en RAM, para desarrollo)
MEMORY_KIND=memory

# Postgres para memoria persistente/concurrente
# Usar cuando MEMORY_KIND=postgres
POSTGRES_URL=postgresql://usuario:password@localhost:5432/chatbot


# API key del proveedor que uses (llena solo la que aplique)
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Kommo (opcional, para integrar WhatsApp/CRM)
# KOMMO_BASE_URL=https://tu-subdominio.amocrm.com
# KOMMO_ACCESS_TOKEN=
# KOMMO_AI_PAUSED_FIELD_ID=
# KOMMO_AI_PAUSED_VALUES=1,true,si,sí,yes
# KOMMO_ALLOWED_LEAD_IDS=31128510
# KOMMO_SALESBOT_ID=76142

# Politica de escalamiento: default, appointment_agent, sales_agent
HANDOFF_POLICY=default
